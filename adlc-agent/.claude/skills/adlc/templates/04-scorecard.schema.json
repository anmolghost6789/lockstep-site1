{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADLC Evaluation Scorecard",
  "type": "object",
  "required": ["intent_id", "evaluated_build", "metrics", "verdict", "evaluator"],
  "properties": {
    "intent_id": {"type": "string"},
    "evaluated_build": {
      "type": "object",
      "required": ["commit", "units_sha256", "dataset", "cases"],
      "properties": {
        "commit": {"type": "string"},
        "units_sha256": {"type": "string"},
        "dataset": {"type": "object", "required": ["path", "version", "sha256"]},
        "cases": {"type": "integer", "minimum": 1}
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "name", "threshold", "comparator", "value", "passed", "trace", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^EVAL-\\d{3}$"},
          "category": {"enum": ["functional", "llm", "rag", "tool", "security", "performance", "cost", "regression"]},
          "name": {"type": "string"},
          "threshold": {"type": "number"},
          "comparator": {"enum": [">=", "<=", "=="]},
          "value": {"type": "number"},
          "passed": {"type": "boolean"},
          "trace": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(NFR|SC)-\\d{3}$"}},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "verdict": {"enum": ["pass", "fail"]},
    "route_back": {"enum": [null, "discover-define", "architect-design", "build-orchestrate"]},
    "evaluator": {
      "type": "object",
      "required": ["agent", "model"],
      "properties": {"agent": {"type": "string"}, "model": {"type": "string"}}
    }
  }
}
