    {"id": "copilot-agent-opus", "harness": "github-copilot", "model": "claude-opus-5-5", "capabilities": ["requirements", "design", "architecture", "coding", "testing", "evaluation", "review", "security"], "max_data_level": "confidential", "cost": 8, "approved": true},
    {"id": "claude-code-haiku", "harness": "claude-code", "model": "claude-haiku-4-5-20251001", "capabilities": ["coding", "testing", "docs"], "max_data_level": "internal", "cost": 1, "approved": true},
    {"id": "self-hosted-coder", "harness": "claude-code", "model": "client-hosted-model", "capabilities": ["coding", "testing"], "max_data_level": "restricted", "cost": 2, "approved": false}
