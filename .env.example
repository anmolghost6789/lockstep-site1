# Registry storage. On Vercel, add Postgres from the Marketplace (e.g. Neon); it sets DATABASE_URL for you.
# Leave unset locally to use the file store in .data/.
DATABASE_URL=

# First administrator, created on first run if there are no users yet.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-me-to-something-long

# Signs login sessions. At least 32 random characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Client-hosted Enterprise installs: hide the marketing pages and serve only the registry.
REGISTRY_ONLY=false
